# Never serve dotfiles. A copy of .env was previously left in this directory by
# a deploy script, and with no rule like this it was fetchable over HTTP.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Serve /storage through the application, not the web server.
    #
    # The intended arrangement is the public/storage symlink plus static
    # serving, which is faster and needs no PHP. This host does not reliably
    # deliver it: banners returned 403 with every directory on the path
    # traversable and the file 0644, and neither `Options +FollowSymLinks` nor
    # `+SymLinksIfOwnerMatch` changed anything.
    #
    # Forcing every /storage request into index.php makes the outcome the same
    # whichever layer was refusing, at the cost of a PHP process per image.
    # See App\Http\Controllers\PublicStorageController.
    #
    # This has to come before the front-controller conditions below, which only
    # forward a request when the file does not exist.
    RewriteRule ^storage/ index.php [L]

    # Block dotfiles anywhere in the path.
    RewriteRule (^|/)\. - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
