APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taga
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Every email is a queued job, so nothing is delivered unless something drains
# the queue. routes/console.php schedules `queue:work --stop-when-empty` every
# minute, which means the single cron entry below is enough on shared hosting:
#
#     * * * * * cd /path/to/backend && php artisan schedule:run >> /dev/null 2>&1
#
# Set this to `sync` only if you have no cron at all -- jobs then run inline and
# every registration and checkout waits for SMTP before responding.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL_FROM_ADDRESS MUST BE THE MAILBOX YOU AUTHENTICATE AS.
#
# Hostinger (and most shared SMTP) refuses to send as an address the logged-in
# account does not own:
#
#     553 5.7.1 <support@taga.ng>: Sender address rejected:
#                not owned by user hello@z1stores.com
#
# That single mismatch failed every one of the first 53 emails this app tried
# to send. If you want mail to come from support@taga.ng, create that mailbox
# in Hostinger and authenticate as it -- do not just change the From line.
#
# Port 465 is implicit SSL; port 587 is STARTTLS. Pick the pair, not one of each.
# Check the whole setup with: php artisan mail:doctor --send=you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- The three mailboxes -----------------------------------------------------
#
# Each Hostinger mailbox is its own SMTP account and may only send as its own
# address, so a different From means a different login -- not just a different
# MAIL_FROM_ADDRESS. config/mail.php derives each mailer's From from its own
# username, which makes the "553 Sender address rejected" mismatch impossible
# to reintroduce.
#
#   noreply  sign-up, email verification, password reset
#   shop     orders, cart, reminders, delivery, payouts, store/agent updates
#   support  anything a person is expected to reply to
#
# Replies to noreply and shop are pointed at support.
#
# Anything left blank falls back to the base MAIL_* values above, so the
# platform keeps sending while the other mailboxes are still being set up.
#
# Verify with: php artisan mail:doctor --send=you@example.com --mailbox=shop

MAIL_NOREPLY_USERNAME=noreply@taga.ng
MAIL_NOREPLY_PASSWORD=

MAIL_SHOP_USERNAME=shop@taga.ng
MAIL_SHOP_PASSWORD=

MAIL_SUPPORT_USERNAME=support@taga.ng
MAIL_SUPPORT_PASSWORD=

# Only needed if a mailbox uses a different server or port from the base:
# MAIL_NOREPLY_HOST=  MAIL_NOREPLY_PORT=  MAIL_NOREPLY_ENCRYPTION=
# MAIL_SHOP_HOST=     MAIL_SHOP_PORT=     MAIL_SHOP_ENCRYPTION=
# MAIL_SUPPORT_HOST=  MAIL_SUPPORT_PORT=  MAIL_SUPPORT_ENCRYPTION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Frontend URL for callbacks
FRONTEND_URL=https://taga.ng

# Google Sign-In. Must be the SAME client id the storefront builds with
# (frontend/.env VITE_GOOGLE_CLIENT_ID) -- the backend checks it as the `aud`
# claim of every Google ID token, so a mismatch rejects every sign-in.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
